{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/proconnect-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "WithThreadId", "WithProcessId" ], //"FromLogContext", "WithMachineName"
    "Properties": {
      "Application": "ProConnect"
    }
  },
  "CacheConfig": {
    "CacheType": "REDIS",
    "ExpirationMode": "Sliding",
    "DatabaseIndex": 0,
    "Timeout": 864000, // second
    "ConnectionString": "redis-10100.ctcldevrds.msoclient.com:10100,keepAlive=180,allowAdmin=True,connectTimeout=1000,connectRetry=3,ssl=true,sslProtocols=Tls12,password=Passw0rd1!"
  },
  "CacheAsideConfig": {
    "EnableCacheAside": true,
    "Timeout": 864000, // second
    "CacheAsideTimeout": 864000 // second
  },
  "ProConnectConfig": {
    "JwtConfig": {
      "secret": "", // set via `dotnet user-secrets set "ProConnectConfig:JwtConfig:secret" "<value>"` in ProConnect.WebApi - do not commit a real value here
      "issuer": "ProConnect",
      "audience": "ProConnectClient",
      "expiryinminutes": 60
    },
    "LinkedInApplicationConfig": {
      "client_id": "86w5rg3vmd0jpf",
      "client_secret": "0lCJat6YN1vaQEvK",
      "redirect_url": "https://localhost:44321/api/user/v1/linkedinauthentication",
      "linkedin_baseurl": "https://www.linkedin.com/oauth/v2",
      "linkedin_api_baseurl": "https://api.linkedin.com/v2",
      "linkedin_accesstokenpath": "/accessToken",
      "linkedin_userinfopath": "/userinfo"
    },
    "HarvestApiConfig": {
      // Proxycurl (the old value here) was sued by LinkedIn/Microsoft and shut down in 2025 - migrated to
      // harvestapi/linkedin-profile-scraper on Apify. ref: https://apify.com/harvestapi/linkedin-profile-scraper
      "apitoken": "apify_api_TAyxukm4K47oYJqIp4kLVC7kc3xXdc3EJWAA", // TODO: temporary - move to Azure Key Vault; kept here deliberately for now instead of user-secrets
      "baseurl": "https://api.apify.com/v2",
      "actorid": "harvestapi~linkedin-profile-scraper",
      "profilescrapermode": "Profile details no email ($4 per 1k)", // cheaper default; use "Profile details + email search ($10 per 1k)" to also attempt email discovery
      "timeoutinseconds": 120
    }
  }
}
