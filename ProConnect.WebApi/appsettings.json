{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/proconnect-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "WithThreadId", "WithProcessId" ], //"FromLogContext", "WithMachineName"
    "Properties": {
      "Application": "ProConnect"
    }
  },
  // All cache-related settings live under this one key, grouped by the layer that consumes each
  // sub-section (same "nest unrelated POCOs under one umbrella" pattern ProConnectConfig uses below) -
  // Redis (connection/store settings, read by RedisCache), CacheAside (the cache-aside behavior toggle,
  // read by Cache), and Expiry (per-region TTLs, read directly by the services that cache something).
  "Cache": {
    "Redis": {
      "CacheType": "REDIS",
      "ExpirationMode": "Sliding",
      "DatabaseIndex": 0,
      "ConnectionString": "localhost:6379,connectTimeout=1000,connectRetry=3" // local dockerized redis (see docker-compose.db.yml) - move to Azure Key Vault before prod
    },
    "CacheAside": {
      "EnableCacheAside": true
    },
    "Expiry": {
      // Per-region cache TTLs - how long stale data (e.g. a cached LinkedIn profile pic/data) is served
      // before the next read re-fetches from the source of truth (3rd-party API or DB).
      "PersonProfile": 604800, // second (7 days) - LinkedIn profile scrape cache (UserService.FetchLinkedInProfile)
      "MatchRecommendation": 900, // second (15 min)
      "SearchResult": 300, // second (5 min)
      "Geocode": 7776000, // second (90 days)
      "UserProfile": 600, // second (10 min)
      "EffectivePlan": 600 // second (10 min)
    }
  },
  "ProConnectConfig": {
    "JwtConfig": {
      "secret": "", // set via `dotnet user-secrets set "ProConnectConfig:JwtConfig:secret" "<value>"` in ProConnect.WebApi - do not commit a real value here
      "issuer": "ProConnect",
      "audience": "ProConnectClient",
      "expiryinminutes": 60,
      "refreshtokenexpiryindays": 30
    },
    "LinkedInApplicationConfig": {
      "client_id": "86w5rg3vmd0jpf",
      "client_secret": "0lCJat6YN1vaQEvK",
      "redirect_url": "https://localhost:44321/api/user/v1/linkedinauthentication",
      "linkedin_baseurl": "https://www.linkedin.com/oauth/v2",
      "linkedin_api_baseurl": "https://api.linkedin.com/v2",
      "linkedin_accesstokenpath": "/accessToken",
      "linkedin_userinfopath": "/userinfo"
    },
    "HarvestApiConfig": {
      // Proxycurl (the old value here) was sued by LinkedIn/Microsoft and shut down in 2025 - migrated to
      // harvestapi/linkedin-profile-scraper on Apify. ref: https://apify.com/harvestapi/linkedin-profile-scraper
      "apitoken": "apify_api_TAyxukm4K47oYJqIp4kLVC7kc3xXdc3EJWAA", // TODO: temporary - move to Azure Key Vault; kept here deliberately for now instead of user-secrets
      "baseurl": "https://api.apify.com/v2",
      "actorid": "harvestapi~linkedin-profile-scraper",
      "profilescrapermode": "Profile details no email ($4 per 1k)", // cheaper default; use "Profile details + email search ($10 per 1k)" to also attempt email discovery
      "timeoutinseconds": 120
    },
    "DataBaseConfig": {
      "connectionstring": "" // set per-environment in appsettings.{Environment}.json - do not commit a real value here
    },
    "GeocodingConfig": {
      "baseurl": "", // set per-environment in appsettings.{Environment}.json
      "useragent": "",
      "timeoutinseconds": 10
    },
    "StripeConfig": {
      "secretkey": "", // set via `dotnet user-secrets set "ProConnectConfig:StripeConfig:secretkey" "<value>"` in ProConnect.WebApi - do not commit a real value here
      "publishablekey": "", // set via `dotnet user-secrets set "ProConnectConfig:StripeConfig:publishablekey" "<value>"` - not actually secret, but kept alongside the rest of the Stripe config
      "webhooksecret": "" // set via `dotnet user-secrets set "ProConnectConfig:StripeConfig:webhooksecret" "<value>"` - do not commit a real value here
    },
    "PushConfig": {
      "serviceaccountjson": "" // set via `dotnet user-secrets set "ProConnectConfig:PushConfig:serviceaccountjson" "<value>"` in ProConnect.WebApi - the raw FCM service-account JSON blob; do not commit a real value here. Until set, FcmPushNotificationGateway throws lazily at first send (same "built but dark" shape as an empty StripeConfig:secretkey), it never blocks startup.
    },
    "EmailConfig": {
      // SMTP relay for campaign/notification emails (welcome email, etc. - see IEmailGateway/
      // SmtpEmailGateway and EmailTemplateRenderer). Same "built but dark" story as PushConfig: until
      // host/username/password are set, SmtpEmailGateway throws lazily at first send, never at startup.
      // Set via `dotnet user-secrets set "ProConnectConfig:EmailConfig:<key>" "<value>"` in
      // ProConnect.WebApi - do not commit real host/username/password values here.
      "host": "",
      "port": 587,
      "username": "",
      "password": "",
      "usessl": true,
      "fromaddress": "",
      "fromname": "ProConnect",
      "timeoutinseconds": 30
    },
    "CorsConfig": {
      // Explicit allow-list, not SetIsOriginAllowed(origin => true) - that previously let any site on
      // the internet make a credentialed request against this API. Empty here on purpose: set the
      // real client origin(s) (e.g. "https://app.proconnect.com") per-environment in
      // appsettings.{Environment}.json - do not widen this in production.
      "AllowedOrigins": []
    },
    "RateLimitingConfig": {
      // Fixed-window limiter, counter centralized in Redis (IRateLimiterStore) so every instance of this
      // API shares one count per caller - partitioned by authenticated userid, falling back to client IP
      // for anonymous requests (see RateLimitPartitionKeyResolver). Global applies to every request as a
      // basic abuse backstop; Strict is opted into via [EnableRateLimiting("strict")] on the LinkedIn
      // scraper (costs real money per call) and the signup/LinkedIn-OAuth entry points
      // (credential-stuffing/abuse risk).
      //
      // Set Enabled to false when an upstream gateway already enforces rate limits in front of this API
      // (e.g. Azure API Management's built-in rate-limit/rate-limit-by-key/quota policies) - this app
      // then skips registering its own Redis-backed limiter and the extra Redis connection it would
      // otherwise open entirely, instead of throttling the same traffic twice under two separately-tuned
      // sets of thresholds.
      //
      // Currently false: Azure API Management is fronting this API and already enforces rate limits
      // there. Flip back to true if APIM's rate limiting is ever removed/bypassed, or for an environment
      // that doesn't sit behind it (e.g. local dev hitting this app directly).
      "Enabled": false,
      "GlobalPermitLimit": 100,
      "GlobalWindowSeconds": 60,
      "StrictPermitLimit": 5,
      "StrictWindowSeconds": 60
    },
    "ForwardedHeadersConfig": {
      // Number of trusted reverse-proxy hops in front of this app that each APPEND (rather than pass
      // through) to X-Forwarded-For - see ForwardedHeadersConfig remarks and Program.cs's
      // app.UseForwardedHeaders(...) call. 1 = Azure App Service's own front end only (the default,
      // correct value for App Service alone). Increase by 1 for each additional Azure edge service
      // (Front Door, Application Gateway, APIM) placed in front of App Service - getting this wrong in
      // the "too high" direction lets a client spoof their own X-Forwarded-For entry and be trusted as
      // the real caller IP.
      "TrustedProxyHopCount": 1
    }
  }
}
