{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cache": {
    "Redis": {
      // local dockerized redis (see docker-compose.db.yml) - appsettings.json intentionally leaves this blank
      "ConnectionString": "localhost:6379,connectTimeout=1000,connectRetry=3"
    }
  },
  "ProConnectConfig": {
    "DataBaseConfig": {
      // local dockerized postgres+postgis (see docker-compose.db.yml); throwaway local-only credentials
      "connectionstring": "Host=localhost;Port=5432;Database=proconnect;Username=proconnect;Password=proconnect_dev_local"
    },
    "GeocodingConfig": {
      "baseurl": "https://nominatim.openstreetmap.org",
      "useragent": "ProConnect-Dev/1.0 (local development)",
      "timeoutinseconds": 10
    }
  }
}
